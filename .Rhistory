df_upc$key <- paste(
df_upc$basin_id,
df_upc$site_id,
df_upc$transect,
substr(as.character(df_upc$year), 3, 4),
sep = "_")
df_upc <- front.ofthe.line(df_upc)
return(df_upc)
}
